.vscode/*
.yarn/*

node_modules/

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*
# Keep the committed bundles and the runtime assets needed beside them.
/dist/*
!/dist/*.js
!/dist/assets/
!/dist/audio/
/dist/audio/*
!/dist/audio/sbc.wasm
!/dist/audio/LICENSE-libsbc
!/dist/audio/BUILD.json
!/dist/THIRD_PARTY_NOTICES.md
/demo/dist/*
!/demo/dist/*.js
!/demo/dist/assets/
!/demo/dist/audio/
/demo/dist/audio/*
!/demo/dist/audio/sbc.wasm
!/demo/dist/audio/LICENSE-libsbc
!/demo/dist/audio/BUILD.json
!/demo/dist/THIRD_PARTY_NOTICES.md
*.log

# Local audio build/test toolchains (not part of the package)
.audio-tools/
.audio-test/
test-results/
playwright-report/
